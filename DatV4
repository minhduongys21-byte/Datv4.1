local function selectTab(name)
    for tabName, tab in pairs(tabPages) do
        if tabName == name then
            tab.page.Visible = true
            tab.btn.BackgroundColor3 = Color3.fromRGB(40, 43, 52)
            tab.btn.BackgroundTransparency = 0
            tab.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            tab.indicator.Visible = true
        else
            tab.page.Visible = false
            tab.btn.BackgroundColor3 = Color3.fromRGB(32, 34, 40)
            tab.btn.BackgroundTransparency = 0.5
            tab.btn.TextColor3 = Color3.fromRGB(160, 165, 175)
            tab.indicator.Visible = false
        end
    end
end

